{
  "name": "@jerem-gt/ctrl-shared",
  "version": "1.0.0",
  "private": true,
  "description": "Fichiers et code serveur communs à cash-ctrl et shelf-ctrl (deps runtime, Dockerfile, modules TS), installés depuis Git.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:jerem-gt/ctrl-shared",
  "bin": {
    "prepare-runtime-deps": "bin/prepare-runtime-deps.mjs"
  },
  "exports": {
    "./server/*": "./server/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "docker",
    "server",
    "!server/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "better-sqlite3": ">=12",
    "express-session": "^1.18.0",
    "nodemailer": ">=7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "better-sqlite3": "^13.0.3",
    "express-session": "^1.19.0",
    "nodemailer": "^10.3.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
